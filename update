#!/usr/bin/env bash
# Writes data/<version>.json (the format of fenix's stable.json) for each toolchain libfenix supports, from the
# channel manifest of that release. The manifest hashes are those cargo (libnix) pins (master-libnix flake.nix), so
# the data is the same toolchain its releases are built with.
set -euo pipefail
cd "$(dirname "$0")"
mkdir -p data

declare -A manifest_sha256=(
  [1.87.0]="sha256-KUm16pHj+cRedf8vxs/Hd2YWxpOrWZ7UOrwhILdSJBU="
  [1.99.0]="sha256-zm3dyIY2T414ZRR3EhLOvptzG6gta4WZUcawzMUWtqI="
)

for version in "${!manifest_sha256[@]}"; do
  echo "data/$version.json" >&2
  nix eval --impure --raw --expr '
    let
      manifest = builtins.fromTOML (builtins.readFile (builtins.fetchurl {
        url = "https://static.rust-lang.org/dist/channel-rust-'"$version"'.toml";
        sha256 = "'"${manifest_sha256[$version]}"'";
      }));
      available = pkg: builtins.mapAttrs (_: src: { available = true; inherit (src) url hash; })
        (builtins.removeAttrs pkg.target
          (builtins.filter (t: !(pkg.target.${t}.available or false)) (builtins.attrNames pkg.target)));
      pkgs = builtins.mapAttrs (_: pkg: { target = available pkg; }) manifest.pkg;
    in
    builtins.toJSON {
      inherit (manifest) date profiles;
      pkg = builtins.removeAttrs pkgs (builtins.filter (c: pkgs.${c}.target == { }) (builtins.attrNames pkgs));
    }' | jq --indent 0 . > "data/$version.json"
done
